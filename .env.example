# Telegram account used by parser: https://my.telegram.org
API_ID=
API_HASH=
CHAT_ID=@source_channel

# Telegram bot used by sender
BOT_TOKEN=
ADMIN_ID=

# RabbitMQ: use a random hex password (for example: openssl rand -hex 24).
RABBITMQ_USER=telegram
RABBITMQ_PASSWORD=
RABBITMQ_QUEUE=telegram_posts

# Optional SOCKS5 proxy for parser. Empty means a direct connection.
# This must be reachable from the container; 127.0.0.1 is the container itself.
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=2080
